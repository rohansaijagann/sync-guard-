# Environment Configuration for Sync Guard
# Copy this file to .env and adjust variables as needed.

APP_ENV=local
APP_DEBUG=true

# Database Configuration (Docker defaults)
# When running with Docker Compose: DB_HOST=db
# When running locally with XAMPP / Native MySQL: DB_HOST=127.0.0.1
DB_HOST=db
DB_PORT=3306
DB_NAME=sync_guard
DB_USER=sync_user
DB_PASS=sync_pass
DB_ROOT_PASS=rootsecret

# Adapter & HTTP Timeouts (seconds)
ADAPTER_CONNECT_TIMEOUT_SECONDS=2
ADAPTER_TIMEOUT_SECONDS=5

# Mock Channel Shared Secret (HMAC-SHA256 signature verification)
MOCK_SHARED_SECRET=dev_mock_shared_secret_7c9f8a2b4e6d1c3a

# Worker Daemon Settings
WORKER_BATCH_SIZE=10
WORKER_INTERVAL_SECONDS=3
WORKER_STUCK_AFTER_SECONDS=300

# Retry & Exponential Backoff Settings
RETRY_JITTER_PERCENT=10

# Channel Health Window (number of recent attempts)
HEALTH_WINDOW_ATTEMPTS=50

# Demo Controls (local development and live demonstrations - disabled by default)
DEMO_CONTROLS_ENABLED=false

# Insights Window (hours)
INSIGHTS_WINDOW_HOURS=24

